{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "user-account.json",
    "title": "UserAccount",
    "type": "object",
    "customDotnetType": "Resources.JsonSchema.UserAccount, Resources",
    "additionalProperties": false,
    "properties": {
        "accountId": {
            "description": "Account identifier",
            "type": "string"
        },
        "isActive": {
            "description": "Whether the account is active",
            "type": "boolean"
        },
        "user": {
            "$ref": "user.json"
        }
    },
    "required": [
        "accountId",
        "isActive",
        "user"
    ]
}
